
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression

# Q6: Simple Linear Regression - Salary Prediction
data1 = {
    "Experience": [1, 2, 3, 4, 5],
    "Salary": [25000, 28000, 32000, 36000, 40000]
}

df1 = pd.DataFrame(data1)
X1 = df1[["Experience"]]
y1 = df1["Salary"]

model1 = LinearRegression()
model1.fit(X1, y1)

print("Predicted Salary:", model1.predict(pd.DataFrame({"Experience": [6.5]}))[0])

plt.scatter(X1, y1)
plt.plot(X1, model1.predict(X1))
plt.xlabel("Experience")
plt.ylabel("Salary")
plt.title("Experience vs Salary")
plt.show()


# Q7: Multiple Linear Regression - House Price Prediction
data2 = {
    "Area": [800, 1000, 1200, 1400, 1600],
    "Bedrooms": [2, 2, 3, 3, 3],
    "Age": [10, 8, 7, 6, 5],
    "Price": [35, 42, 50, 58, 65]
}

df2 = pd.DataFrame(data2)
X2 = df2[["Area", "Bedrooms", "Age"]]
y2 = df2["Price"]

model2 = LinearRegression()
model2.fit(X2, y2)

new_house = pd.DataFrame({
    "Area": [1300],
    "Bedrooms": [3],
    "Age": [5]
})

print("Predicted House Price:", model2.predict(new_house)[0])

plt.scatter(df2["Area"], y2)
plt.plot(df2["Area"], model2.predict(X2))
plt.xlabel("Area")
plt.ylabel("Price")
plt.title("Area vs House Price")
plt.show()
