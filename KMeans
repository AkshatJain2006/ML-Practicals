
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans

data = {
    "Customer": ["C001", "C002", "C003", "C004", "C005"],
    "Annual_Income": [25000, 28000, 32000, 45000, 48000],
    "Spending_Score": [30, 25, 35, 70, 75]
}

df = pd.DataFrame(data)
X = df[["Annual_Income", "Spending_Score"]]

model = KMeans(n_clusters=3, random_state=42, n_init=10)
df["Cluster"] = model.fit_predict(X)

print(df)

plt.scatter(
    df["Annual_Income"], df["Spending_Score"],
    c=df["Cluster"], cmap="viridis", s=100
)

centroids = model.cluster_centers_
plt.scatter(
    centroids[:, 0], centroids[:, 1],
    color="red", marker="X", s=200, label="Centroids"
)

plt.xlabel("Annual Income")
plt.ylabel("Spending Score")
plt.title("Customer Clustering using K-Means")
plt.legend()
plt.grid(True)
plt.show()
